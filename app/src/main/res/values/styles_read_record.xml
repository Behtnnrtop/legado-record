<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ReadRecordTabText">
        <item name="android:textSize">17sp</item>
        <item name="textAllCaps">false</item>
    </style>


    <style name="ReadRecordRecentBookItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_item_focused_on_tv</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:minHeight">168dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="ReadRecordRecentBookCover">
        <item name="android:layout_width">78dp</item>
        <item name="android:layout_height">108dp</item>
        <item name="android:contentDescription">@string/img_cover</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:src">@drawable/image_cover_default</item>
    </style>

    <style name="ReadRecordRecentBookName">
        <item name="android:layout_width">78dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">top|center_horizontal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lines">2</item>
        <item name="android:textColor">@color/primaryText</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ReadRecordRecentBookProgressText">
        <item name="android:layout_width">78dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ReadRecordRecentBookProgress" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:layout_width">78dp</item>
        <item name="android:layout_height">3dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:max">100</item>
        <item name="android:progress">0</item>
        <item name="android:indeterminate">false</item>
        <item name="android:progressDrawable">@drawable/bg_read_record_progress</item>
    </style>

        <style name="ReadRecordPeriodNavButton">
        <item name="android:layout_width">14dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">@drawable/bg_item_focused_on_tv</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>


    <style name="ReadRecordPeriodModeButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_item_focused_on_tv</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/tv_text_summary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ReadRecordPeriodValueItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>

    <style name="ReadRecordPeriodValueText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/primaryText</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ReadRecordPeriodLabelText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">7dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/tv_text_summary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ReadRecordTopBookItem">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">82dp</item>
        <item name="android:background">@drawable/bg_item_focused_on_tv</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="ReadRecordTopBookCover">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:contentDescription">@string/img_cover</item>
        <item name="android:scaleType">centerCrop</item>
        <item name="android:src">@drawable/image_cover_default</item>
    </style>

    <style name="ReadRecordTopBookRank">
        <item name="android:layout_width">28dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/tv_text_summary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ReadRecordTopBookName">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/primaryText</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ReadRecordTopBookAuthor">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/tv_text_summary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="ReadRecordTopBookTime">
        <item name="android:layout_width">76dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:gravity">end</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/primaryText</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="ReadRecordTopBookProgress" parent="@android:style/Widget.ProgressBar.Horizontal">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">3dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:max">100</item>
        <item name="android:progress">0</item>
        <item name="android:indeterminate">false</item>
        <item name="android:progressDrawable">@drawable/bg_read_record_progress</item>
    </style>

    <style name="ReadRecordSectionDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">8dp</item>
        <item name="android:layout_marginTop">43dp</item>
        <item name="android:background">@color/bg_divider_line</item>
    </style>

</resources>
