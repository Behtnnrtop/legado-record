<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <io.legado.app.ui.widget.TitleBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:attachToActivity="false"
        app:title="@string/read_record" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_total_read_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="24dp"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:maxLines="2"
                android:textColor="@color/primaryText"
                android:textSize="18sp" />

            <HorizontalScrollView
                android:id="@+id/hsv_heatmap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="24dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <io.legado.app.ui.widget.ReadRecordHeatmapView
                    android:id="@+id/read_record_heatmap"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/ll_recent_read"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_recent_read_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/recent_reading"
                    android:textColor="@color/primaryText"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/ll_recent_read_books"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/ll_recent_book_1"
                        style="@style/ReadRecordRecentBookItem"
                        android:gravity="start">

                        <io.legado.app.ui.widget.image.CoverImageView
                            android:id="@+id/iv_recent_cover_1"
                            style="@style/ReadRecordRecentBookCover" />

                        <TextView
                            android:id="@+id/tv_recent_name_1"
                            style="@style/ReadRecordRecentBookName" />

                        <TextView
                            android:id="@+id/tv_recent_progress_1"
                            style="@style/ReadRecordRecentBookProgressText" />

                        <ProgressBar
                            android:id="@+id/pb_recent_progress_1"
                            style="@style/ReadRecordRecentBookProgress" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_recent_book_2"
                        style="@style/ReadRecordRecentBookItem">

                        <io.legado.app.ui.widget.image.CoverImageView
                            android:id="@+id/iv_recent_cover_2"
                            style="@style/ReadRecordRecentBookCover" />

                        <TextView
                            android:id="@+id/tv_recent_name_2"
                            style="@style/ReadRecordRecentBookName" />

                        <TextView
                            android:id="@+id/tv_recent_progress_2"
                            style="@style/ReadRecordRecentBookProgressText" />

                        <ProgressBar
                            android:id="@+id/pb_recent_progress_2"
                            style="@style/ReadRecordRecentBookProgress" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_recent_book_3"
                        style="@style/ReadRecordRecentBookItem">

                        <io.legado.app.ui.widget.image.CoverImageView
                            android:id="@+id/iv_recent_cover_3"
                            style="@style/ReadRecordRecentBookCover" />

                        <TextView
                            android:id="@+id/tv_recent_name_3"
                            style="@style/ReadRecordRecentBookName" />

                        <TextView
                            android:id="@+id/tv_recent_progress_3"
                            style="@style/ReadRecordRecentBookProgressText" />

                        <ProgressBar
                            android:id="@+id/pb_recent_progress_3"
                            style="@style/ReadRecordRecentBookProgress" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_recent_book_4"
                        style="@style/ReadRecordRecentBookItem"
                        android:gravity="end">

                        <io.legado.app.ui.widget.image.CoverImageView
                            android:id="@+id/iv_recent_cover_4"
                            style="@style/ReadRecordRecentBookCover" />

                        <TextView
                            android:id="@+id/tv_recent_name_4"
                            style="@style/ReadRecordRecentBookName" />

                        <TextView
                            android:id="@+id/tv_recent_progress_4"
                            style="@style/ReadRecordRecentBookProgressText" />

                        <ProgressBar
                            android:id="@+id/pb_recent_progress_4"
                            style="@style/ReadRecordRecentBookProgress" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_recent_read_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:includeFontPadding="false"
                    android:text="@string/no_recent_read"
                    android:textColor="@color/tv_text_summary"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>

            <View
                style="@style/ReadRecordSectionDivider" />

            <LinearLayout
                android:id="@+id/ll_period_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="23dp"
                android:layout_marginEnd="24dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_period_summary_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:text="@string/read_record_period_summary"
                        android:textColor="@color/primaryText"
                        android:textSize="16sp" />

                    <LinearLayout
                        android:id="@+id/ll_period_mode"
                        android:layout_width="110dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_read_record_seg_bg"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:padding="2dp">

                        <TextView
                            android:id="@+id/tv_period_year"
                            style="@style/ReadRecordPeriodModeButton"
                            android:background="@drawable/bg_read_record_seg_item"
                            android:text="@string/read_record_period_year" />

                        <TextView
                            android:id="@+id/tv_period_month"
                            style="@style/ReadRecordPeriodModeButton"
                            android:background="@drawable/bg_read_record_seg_item"
                            android:text="@string/read_record_period_month" />

                        <TextView
                            android:id="@+id/tv_period_week"
                            style="@style/ReadRecordPeriodModeButton"
                            android:background="@drawable/bg_read_record_seg_item"
                            android:text="@string/read_record_period_week" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/tv_period_previous"
                        style="@style/ReadRecordPeriodNavButton"
                        android:contentDescription="@string/read_record_previous_period"
                        android:scaleType="center"
                        android:src="@drawable/ic_read_record_chevron_left" />


                    <TextView
                        android:id="@+id/tv_period_range"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/primaryText"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/tv_period_next"
                        style="@style/ReadRecordPeriodNavButton"
                        android:contentDescription="@string/read_record_next_period"
                        android:scaleType="center"
                        android:src="@drawable/ic_read_record_chevron_right" />


                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_period_values"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        style="@style/ReadRecordPeriodValueItem"
                        android:layout_marginEnd="8dp">

                        <TextView
                            android:id="@+id/tv_period_total_time"
                            style="@style/ReadRecordPeriodValueText"
                            android:textStyle="normal" />

                        <TextView
                            style="@style/ReadRecordPeriodLabelText"
                            android:text="@string/read_record_total_time" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/ReadRecordPeriodValueItem"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp">

                        <TextView
                            android:id="@+id/tv_period_read_days"
                            style="@style/ReadRecordPeriodValueText"
                            android:textStyle="normal" />

                        <TextView
                            style="@style/ReadRecordPeriodLabelText"
                            android:text="@string/read_record_read_days" />

                    </LinearLayout>

                    <LinearLayout
                        style="@style/ReadRecordPeriodValueItem"
                        android:layout_marginStart="8dp">

                        <TextView
                            android:id="@+id/tv_period_book_count"
                            style="@style/ReadRecordPeriodValueText"
                            android:textStyle="normal" />

                        <TextView
                            style="@style/ReadRecordPeriodLabelText"
                            android:text="@string/read_record_book_count" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_top_books"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="23dp"
                android:layout_marginEnd="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_top_books_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/read_record_top_books"
                    android:textColor="@color/primaryText"
                    android:textSize="16sp" />

                <LinearLayout
                    android:id="@+id/ll_top_books_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/ll_top_book_1"
                        style="@style/ReadRecordTopBookItem">

                        <TextView
                            android:id="@+id/tv_top_book_rank_1"
                            style="@style/ReadRecordTopBookRank" />

                        <io.legado.app.ui.widget.image.CoverImageView
                            android:id="@+id/iv_top_book_cover_1"
                            style="@style/ReadRecordTopBookCover" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_top_book_name_1"
                                style="@style/ReadRecordTopBookName" />

                            <TextView
                                android:id="@+id/tv_top_book_author_1"
                                style="@style/ReadRecordTopBookAuthor" />

                            <ProgressBar
                                android:id="@+id/pb_top_book_progress_1"
                                style="@style/ReadRecordTopBookProgress" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_top_book_time_1"
                            style="@style/ReadRecordTopBookTime" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_top_book_2"
                        style="@style/ReadRecordTopBookItem">

                        <TextView
                            android:id="@+id/tv_top_book_rank_2"
                            style="@style/ReadRecordTopBookRank" />

                        <io.legado.app.ui.widget.image.CoverImageView
                            android:id="@+id/iv_top_book_cover_2"
                            style="@style/ReadRecordTopBookCover" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_top_book_name_2"
                                style="@style/ReadRecordTopBookName" />

                            <TextView
                                android:id="@+id/tv_top_book_author_2"
                                style="@style/ReadRecordTopBookAuthor" />

                            <ProgressBar
                                android:id="@+id/pb_top_book_progress_2"
                                style="@style/ReadRecordTopBookProgress" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_top_book_time_2"
                            style="@style/ReadRecordTopBookTime" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_top_book_3"
                        style="@style/ReadRecordTopBookItem">

                        <TextView
                            android:id="@+id/tv_top_book_rank_3"
                            style="@style/ReadRecordTopBookRank" />

                        <io.legado.app.ui.widget.image.CoverImageView
                            android:id="@+id/iv_top_book_cover_3"
                            style="@style/ReadRecordTopBookCover" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_top_book_name_3"
                                style="@style/ReadRecordTopBookName" />

                            <TextView
                                android:id="@+id/tv_top_book_author_3"
                                style="@style/ReadRecordTopBookAuthor" />

                            <ProgressBar
                                android:id="@+id/pb_top_book_progress_3"
                                style="@style/ReadRecordTopBookProgress" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_top_book_time_3"
                            style="@style/ReadRecordTopBookTime" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_top_book_4"
                        style="@style/ReadRecordTopBookItem">

                        <TextView
                            android:id="@+id/tv_top_book_rank_4"
                            style="@style/ReadRecordTopBookRank" />

                        <io.legado.app.ui.widget.image.CoverImageView
                            android:id="@+id/iv_top_book_cover_4"
                            style="@style/ReadRecordTopBookCover" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_top_book_name_4"
                                style="@style/ReadRecordTopBookName" />

                            <TextView
                                android:id="@+id/tv_top_book_author_4"
                                style="@style/ReadRecordTopBookAuthor" />

                            <ProgressBar
                                android:id="@+id/pb_top_book_progress_4"
                                style="@style/ReadRecordTopBookProgress" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_top_book_time_4"
                            style="@style/ReadRecordTopBookTime" />

                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/tv_top_books_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:includeFontPadding="false"
                    android:text="@string/read_record_top_books_empty"
                    android:textColor="@color/tv_text_summary"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>

            <View
                style="@style/ReadRecordSectionDivider" />

            <LinearLayout
                android:id="@+id/ll_week_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="23dp"
                android:layout_marginEnd="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_week_bar_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/read_record_week_bar_title"
                    android:textColor="@color/primaryText"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/tv_week_bar_previous"
                        style="@style/ReadRecordPeriodNavButton"
                        android:contentDescription="@string/read_record_previous_week"
                        android:scaleType="center"
                        android:src="@drawable/ic_read_record_chevron_left" />


                    <TextView
                        android:id="@+id/tv_week_bar_range"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:singleLine="true"
                        android:textColor="@color/primaryText"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/tv_week_bar_next"
                        style="@style/ReadRecordPeriodNavButton"
                        android:contentDescription="@string/read_record_next_week"
                        android:scaleType="center"
                        android:src="@drawable/ic_read_record_chevron_right" />


                </LinearLayout>

                <io.legado.app.ui.widget.ReadRecordWeekBarChartView
                    android:id="@+id/read_record_week_bar_chart"
                    android:layout_width="match_parent"
                    android:layout_height="176dp"
                    android:layout_marginTop="10dp" />

            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_hour_histogram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="23dp"
                android:layout_marginEnd="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_hour_histogram_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/read_record_hour_histogram_title"
                    android:textColor="@color/primaryText"
                    android:textSize="16sp" />

                <io.legado.app.ui.main.readrecord.ReadRecordHourHistogramView
                    android:id="@+id/read_record_hour_histogram"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="10dp" />

            </LinearLayout>
            <FrameLayout
                android:id="@+id/fl_empty_content"
                android:layout_width="match_parent"
                android:layout_height="240dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
